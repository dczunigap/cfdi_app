### Core app
CFDI_AUTH_SECRET=
CFDI_AUTH_TTL_MINUTES=2880
CFDI_AUTH_PASSWORD_ITERATIONS=390000
CFDI_TIMEOUT_SAT_SECONDS=200
SAT_PASSWORD_SECRET=

### SAT environment
# sat env: "uat" or "prod"
# endpoints are selected only from SAT_ENDPOINTS in config.py (no URL overrides)
SAT_ENV=prod
SAT_DOWNLOAD_DIR=C:\cfdi\xml

### Redis (RQ)
REDIS_URL=redis://localhost:6379/0
