### Core app
CFDI_AUTH_SECRET=
CFDI_AUTH_TTL_MINUTES=2880
CFDI_AUTH_PASSWORD_ITERATIONS=390000
CFDI_TIMEOUT_SAT_SECONDS=200
SAT_PASSWORD_SECRET=

### SAT environment
# sat env: "uat" or "prod"
# endpoints are selected only from SAT_ENDPOINTS in config.py (no URL overrides)
SAT_ENV=prod
SAT_DOWNLOAD_DIR=C:\cfdi\xml

### Redis (RQ)
REDIS_URL=redis://localhost:6379/0

### SAT gateway mode
# "soap" (default) or "mock"
SAT_GATEWAY_MODE=soap
SAT_AUTOVERIFY=1

### Storage backend (fs | r2)
SAT_STORAGE_BACKEND=fs
PDF_STORAGE_BACKEND=fs
PDF_UPLOAD_DIR=C:\cfdi\pdf
R2_ENDPOINT=http://127.0.0.1:9000
R2_ACCESS_KEY=minioadmin
R2_SECRET_KEY=minioadmin
R2_BUCKET=cfdi-zip
PDF_R2_BUCKET=cfdi-pdf
PDF_R2_PREFIX=pdfs
R2_REGION=auto
