### Core app
CFDI_DB_URL=sqlite:///./data/contabilidad.sqlite
CFDI_AUTH_SECRET=
CFDI_AUTH_TTL_MINUTES=2880
CFDI_AUTH_PASSWORD_ITERATIONS=390000
CFDI_TIMEOUT_SAT_SECONDS=200
SAT_PASSWORD_SECRET=

### SAT environment
SAT_ENV=prod
SAT_AUTOVERIFY=1
SAT_GATEWAY_MODE=soap

### Storage backend (fs | r2)
SAT_STORAGE_BACKEND=fs
SAT_DOWNLOAD_DIR=C:\cfdi\xml

### R2 (if SAT_STORAGE_BACKEND=r2)
R2_ENDPOINT=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=
R2_REGION=auto

### Redis (RQ)
REDIS_URL=redis://localhost:6379/0
